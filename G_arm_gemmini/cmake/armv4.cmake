set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_EXTENSIONS OFF CACHE BOOL "" FORCE)
set(CMAKE_C_COMPILER "$ENV{ARM_CC}")
set(CMAKE_CXX_COMPILER "$ENV{ARM_CXX}")
set(CMAKE_AR "$ENV{LLVM_AR}")
set(CMAKE_RANLIB "$ENV{LLVM_RANLIB}")
set(CMAKE_C_COMPILER_TARGET arm-none-eabi)
set(CMAKE_CXX_COMPILER_TARGET arm-none-eabi)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_NEWLIB_INCLUDE)
if(NOT DEFINED ARM_NEWLIB_INCLUDE)
  message(FATAL_ERROR "ARM_NEWLIB_INCLUDE must point to newlib headers")
endif()
set(ARM_FLAGS "-march=armv4 -marm -mfloat-abi=soft -Os -ffunction-sections -fdata-sections -fno-unwind-tables -fno-asynchronous-unwind-tables -isystem ${ARM_NEWLIB_INCLUDE} -DIREE_PLATFORM_GENERIC=1 -DIREE_FILE_IO_ENABLE=0 -DIREE_TIME_NOW_FN=\"{ return 0; }\"")
set(CMAKE_C_FLAGS_INIT "${ARM_FLAGS} -DIREE_HAL_TOPOLOGY_MAX_DEVICE_COUNT=1")
set(CMAKE_CXX_FLAGS_INIT "${ARM_FLAGS} -DIREE_HAL_TOPOLOGY_MAX_DEVICE_COUNT=1")
set(IREE_ENABLE_THREADING OFF CACHE BOOL "" FORCE)
set(IREE_SYNCHRONIZATION_DISABLE_UNSAFE ON CACHE BOOL "" FORCE)
set(IREE_HAL_DRIVER_LOCAL_TASK OFF CACHE BOOL "" FORCE)
set(IREE_ENABLE_WERROR_FLAG OFF CACHE BOOL "" FORCE)
