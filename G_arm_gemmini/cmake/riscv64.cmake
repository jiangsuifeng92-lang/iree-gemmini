include(CheckCSourceCompiles)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "$ENV{RISCV_CC}")
set(CMAKE_CXX_COMPILER "$ENV{RISCV}/bin/riscv64-unknown-elf-g++")
set(CMAKE_AR "$ENV{RISCV}/bin/riscv64-unknown-elf-ar")
set(CMAKE_RANLIB "$ENV{RISCV}/bin/riscv64-unknown-elf-ranlib")
set(IREE_ENABLE_THREADING OFF CACHE BOOL "" FORCE)
set(IREE_SYNCHRONIZATION_DISABLE_UNSAFE ON CACHE BOOL "" FORCE)
set(IREE_ENABLE_WERROR_FLAG OFF CACHE BOOL "" FORCE)
